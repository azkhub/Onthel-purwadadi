	------------------------------------------------------------
	-- RACE: BIKE SPEED (LinearVelocity, 2 mode). Batas maksimal 199 km/jam
	-- (jangan 200+ biar tidak kena banned)
	------------------------------------------------------------
	local BIKE_MAX = 199
	local bikeOn, bikeMode, bikeKmh = false, "smooth", 120 -- mode: smooth | instant
	local bikeConn, bikeLV, bikeAtt = nil, nil, nil
	local bikeTarget = 0 -- target studs untuk mode lereng
	local bikeCut, bikeGasAt, bikeTilt, gasWas = 0, 0, 0, false -- boost mati sampai bikeCut; waktu gas terakhir; hitungan frame miring
	local bikeKHud, bikeKRpm, bikeSafe = 1.16, 0, true -- HUD km/jam per stud/dtk; RPM per stud/dtk; anti macet (batas RPM)
	local bikeDiag = { gas = 0, tilt = 0, air = 0 } -- penghitung penyebab boost putus (tampil di status RACE)
	local bikeSt = nil -- label status di folder RACE (diisi saat susun tampilan)

	local function mkNote(text, color, height)
		local l = label(pageTarget, text, 11, UDim2.new(), UDim2.new(1, 0, 0, height or 30), color or C(180, 190, 210))
		l.LayoutOrder = nextOrd()
		reg(l)
		return l
	end

	local function bikeClear()
		if bikeLV then pcall(function() bikeLV:Destroy() end) bikeLV = nil end
		if bikeAtt then pcall(function() bikeAtt:Destroy() end) bikeAtt = nil end
	end

	local function bikeCtx()
		local hum = lp.Character and lp.Character:FindFirstChildOfClass("Humanoid")
		if not hum or not hum.SeatPart then return nil end
		local model = hum.SeatPart:FindFirstAncestorOfClass("Model")
		while model and not model:FindFirstChild("BikeScript") do
			local p = model.Parent
			model = p and p:FindFirstAncestorOfClass("Model") or nil
		end
		if not model then return nil end
		local bikeScript = model:FindFirstChild("BikeScript")
		local seat = model:FindFirstChild("VehicleSeat", true) or hum.SeatPart
		local values = bikeScript and bikeScript:FindFirstChild("Values")
		local settingsTbl
		local mod = bikeScript and bikeScript:FindFirstChild("BikeSettings")
		if mod then pcall(function() settingsTbl = require(mod) end) end
		local part = seat:IsA("BasePart") and seat or model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart", true)
		return {
			seat = seat, settings = settingsTbl, part = part, model = model,
			velocity = values and values:FindFirstChild("Velocity"),
			wheel = values and values:FindFirstChild("WheelVelocity"),
			gear = values and values:FindFirstChild("Gear"),
		}
	end

	local function bikeEnsureLV(part)
		if bikeLV and bikeLV.Parent == part then return bikeLV end
		bikeClear()
		bikeAtt = Instance.new("Attachment")
		bikeAtt.Name = "SpeedBoostAtt"
		bikeAtt.Parent = part
		bikeLV = Instance.new("LinearVelocity")
		bikeLV.Name = "SpeedBoostLV"
		bikeLV.Attachment0 = bikeAtt
		bikeLV.RelativeTo = Enum.ActuatorRelativeTo.World
		bikeLV.VelocityConstraintMode = Enum.VelocityConstraintMode.Line
		bikeLV.LineDirection = Vector3.new(1, 0, 0)
		bikeLV.ForceLimitsEnabled = true
		bikeLV.MaxForce = 0 -- default off
		bikeLV.LineVelocity = 0
		bikeLV.Parent = part
		return bikeLV
	end

	local lastBikeText = 0
	local function bikeSay(txt)
		if bikeSt and tick() - lastBikeText > 0.25 then
			lastBikeText = tick()
			bikeSt.Text = txt
		end
	end

	local function bikeApply(kmh)
		kmh = math.min(kmh, BIKE_MAX) -- jaga batas maksimal
		local ctx = bikeCtx()
		if not ctx or not ctx.part then
			bikeClear()
			bikeSay("Naik motor dulu")
			return
		end

		local cfg = type(ctx.settings) == "table" and ctx.settings or nil
		-- pulihkan nilai asli kalau versi lama script ini sempat mengubahnya (sebelum rejoin)
		if cfg and (tonumber(cfg.MaxSpeed) or 0) >= 400 then cfg.MaxSpeed = 58 end

		-- gas: Throttle (tombol gas HP / W) atau ThrottleFloat, mana saja yang aktif.
		-- Ditahan 0.15 dtk supaya kedipan singkat (sering terjadi di HP) tidak mematikan boost.
		local now = tick()
		local thr = 0
		if ctx.seat then
			thr = math.max(tonumber(ctx.seat.Throttle) or 0, tonumber(ctx.seat.ThrottleFloat) or 0)
		end
		if thr <= 0 and UIS:IsKeyDown(Enum.KeyCode.W) then thr = 1 end
		if thr > 0.05 then bikeGasAt = now end
		local gasOn = now - bikeGasAt < 0.15
		if gasWas and not gasOn then bikeDiag.gas = bikeDiag.gas + 1 end
		gasWas = gasOn

		local part = ctx.part
		-- terbalik/rebah beneran (bukan cuma miring/wheelie) selama beberapa frame
		if part.CFrame.UpVector.Y < 0.1 then bikeTilt = bikeTilt + 1 else bikeTilt = 0 end
		local upright = bikeTilt < 5
		local lv = bikeEnsureLV(part)
		local look = part.CFrame.LookVector
		local flat = Vector3.new(look.X, 0, look.Z)
		local hasFlat = flat.Magnitude >= 0.05
		if hasFlat then flat = flat.Unit end
		local v = part.AssemblyLinearVelocity
		local fwd = hasFlat and (v.X * flat.X + v.Z * flat.Z) or 0 -- kecepatan searah jalan

		-- RPM dihitung persis seperti HUD game: |WheelVelocity| x MaxSpeed x |Gear_n|
		local rpm, revLimit = 0, nil
		if cfg then
			revLimit = tonumber(cfg.RevLimitRPM)
			local wv = ctx.wheel and tonumber(ctx.wheel.Value) or 0
			local g = ctx.gear and tonumber(ctx.gear.Value)
			local gr = g and tonumber(cfg["Gear_" .. tostring(g)]) or 1
			rpm = math.abs(wv) * (tonumber(cfg.MaxSpeed) or 0) * math.abs(gr)
		end
		local hudV = ctx.velocity and tonumber(ctx.velocity.Value) or 0

		-- kalibrasi otomatis dari motor yang dikendarai
		if fwd > 20 then
			if hudV > 0 then bikeKHud = bikeKHud * 0.95 + (hudV / fwd) * 0.05 end
			if rpm > 0 then
				bikeKRpm = (bikeKRpm == 0) and (rpm / fwd) or (bikeKRpm * 0.95 + (rpm / fwd) * 0.05)
			end
		end
		local need = kmh / bikeKHud -- km/jam di HUD -> studs/dtk
		local limitKmh = nil
		if bikeSafe and revLimit and bikeKRpm > 0 then
			-- ANTI MACET: jaga RPM di bawah rev limiter game (kalau kena limiter, tenaga dipotong berulang)
			local safeStuds = revLimit * 0.9 / bikeKRpm
			if need > safeStuds then need = safeStuds end
			limitKmh = safeStuds * bikeKHud
		end

		-- terlempar ke atas (tabrakan keras): boost putus sebentar. Batas tinggi supaya ramp/bump biasa tidak kena.
		if v.Y > 60 and now >= bikeCut then
			bikeCut = now + 0.4
			bikeDiag.air = bikeDiag.air + 1
		end

		if gasOn and upright and hasFlat and now >= bikeCut then
			if bikeMode == "instant" then
				bikeTarget = need
			elseif bikeTarget < need then
				bikeTarget = math.min(need, bikeTarget + need * 0.03 + 0.8) -- naik pelan ke need
			else
				bikeTarget = need
			end

			-- dorong hanya searah jalan (sumbu atas/bawah dibiarkan natural)
			lv.MaxForce = bikeMode == "instant" and 35000 or 18000
			lv.LineDirection = flat
			lv.LineVelocity = bikeTarget
		else
			-- lepas gas / terbalik / habis terlempar: matikan boost, biar motor ngerem natural
			lv.MaxForce = 0
			lv.LineVelocity = 0
			if now < bikeCut then
				bikeTarget = math.max(0, fwd) -- lanjut dari speed sekarang, bukan dari nol
			else
				bikeTarget = math.max(0, bikeTarget * 0.92)
			end
			if not upright and bikeCut < now + 0.6 then
				bikeCut = now + 0.6
				bikeDiag.tilt = bikeDiag.tilt + 1
			end
		end

		bikeSay(string.format("[%s] set %d | HUD %.0f | RPM %d/%s | batas aman %s\ngas=%s | putus: lepas-gas %d, miring %d, loncat %d",
			bikeMode == "smooth" and "LERENG" or "LANGSUNG", kmh, hudV, math.floor(rpm), revLimit and tostring(revLimit) or "?",
			limitKmh and string.format("%.0f", limitKmh) or "-", gasOn and "ON" or "off",
			bikeDiag.gas, bikeDiag.tilt, bikeDiag.air))
	end

	local function bikeStop()
		bikeOn = false
		if bikeConn then bikeConn:Disconnect() bikeConn = nil end
		bikeClear()
		bikeTarget, bikeCut, bikeTilt, gasWas, bikeKRpm = 0, 0, 0, false, 0
		bikeDiag.gas, bikeDiag.tilt, bikeDiag.air = 0, 0, 0
		if bikeSt then bikeSt.Text = "Speed OFF" end
	end

	local function toggleBike()
		if bikeOn then
			bikeStop()
		else
			bikeOn = true
			bikeConn = RunService.Heartbeat:Connect(function()
				bikeApply(bikeKmh)
			end)
		end
		paint()
	end

