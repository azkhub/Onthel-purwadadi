	------------------------------------------------------------
	-- RACE: BIKE SPEED (LinearVelocity, 2 mode). Batas maksimal 199 km/jam
	-- (jangan 200+ biar tidak kena banned)
	------------------------------------------------------------
	local BIKE_MAX = 199
	local bikeOn, bikeMode, bikeKmh = false, "smooth", 120 -- mode: smooth | instant
	local bikeConn, bikeLV, bikeAtt = nil, nil, nil
	local bikeTarget = 0 -- target studs untuk mode lereng
	local bikeCut, bikeAvg, bikeDrop = 0, 0, 0 -- boost mati sampai bikeCut; rata-rata speed; hitungan frame anjlok
	local bikeSt = nil -- label status di folder RACE (diisi saat susun tampilan)

	local function mkNote(text, color, height)
		local l = label(farmPage, text, 11, UDim2.new(), UDim2.new(1, 0, 0, height or 30), color or C(180, 190, 210))
		l.LayoutOrder = nextOrd()
		reg(l)
		return l
	end

	local function bikeClear()
		if bikeLV then pcall(function() bikeLV:Destroy() end) bikeLV = nil end
		if bikeAtt then pcall(function() bikeAtt:Destroy() end) bikeAtt = nil end
	end

	local function bikeCtx()
		local hum = lp.Character and lp.Character:FindFirstChildOfClass("Humanoid")
		if not hum or not hum.SeatPart then return nil end
		local model = hum.SeatPart:FindFirstAncestorOfClass("Model")
		while model and not model:FindFirstChild("BikeScript") do
			local p = model.Parent
			model = p and p:FindFirstAncestorOfClass("Model") or nil
		end
		if not model then return nil end
		local bikeScript = model:FindFirstChild("BikeScript")
		local seat = model:FindFirstChild("VehicleSeat", true) or hum.SeatPart
		local values = bikeScript and bikeScript:FindFirstChild("Values")
		local settingsTbl
		local mod = bikeScript and bikeScript:FindFirstChild("BikeSettings")
		if mod then pcall(function() settingsTbl = require(mod) end) end
		local part = seat:IsA("BasePart") and seat or model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart", true)
		return { seat = seat, settings = settingsTbl, velocity = values and values:FindFirstChild("Velocity"), part = part, model = model }
	end

	local function bikeEnsureLV(part)
		if bikeLV and bikeLV.Parent == part then return bikeLV end
		bikeClear()
		bikeAtt = Instance.new("Attachment")
		bikeAtt.Name = "SpeedBoostAtt"
		bikeAtt.Parent = part
		bikeLV = Instance.new("LinearVelocity")
		bikeLV.Name = "SpeedBoostLV"
		bikeLV.Attachment0 = bikeAtt
		bikeLV.RelativeTo = Enum.ActuatorRelativeTo.World
		bikeLV.VelocityConstraintMode = Enum.VelocityConstraintMode.Line
		bikeLV.LineDirection = Vector3.new(1, 0, 0)
		bikeLV.ForceLimitsEnabled = true
		bikeLV.MaxForce = 0 -- default off
		bikeLV.LineVelocity = 0
		bikeLV.Parent = part
		return bikeLV
	end

	local lastBikeText = 0
	local function bikeSay(txt)
		if bikeSt and tick() - lastBikeText > 0.25 then
			lastBikeText = tick()
			bikeSt.Text = txt
		end
	end

	local function bikeApply(kmh)
		kmh = math.min(kmh, BIKE_MAX) -- jaga batas maksimal
		local ctx = bikeCtx()
		if not ctx or not ctx.part then
			bikeClear()
			bikeSay("Naik motor dulu")
			return
		end

		if ctx.settings and type(ctx.settings) == "table" then
			ctx.settings.MaxSpeed = math.max(kmh, 400)
		end

		local throttle = 0
		if ctx.seat then
			throttle = tonumber(ctx.seat.ThrottleFloat) or tonumber(ctx.seat.Throttle) or 0
		end
		if throttle <= 0 and UIS:IsKeyDown(Enum.KeyCode.W) then throttle = 1 end

		local part = ctx.part
		local upright = part.CFrame.UpVector.Y > 0.3
		local lv = bikeEnsureLV(part)
		local need = kmh * 1.1 -- km/jam -> studs/dtk

		local look = part.CFrame.LookVector
		local flat = Vector3.new(look.X, 0, look.Z)
		local hasFlat = flat.Magnitude >= 0.05
		if hasFlat then flat = flat.Unit end
		local v = part.AssemblyLinearVelocity
		local fwd = hasFlat and (v.X * flat.X + v.Z * flat.Z) or 0 -- kecepatan searah jalan

		if throttle > 0.05 and upright and hasFlat and tick() >= bikeCut then
			-- tabrakan beneran = speed anjlok tajam dan bertahan beberapa frame (bukan cuma goyang/miring)
			if bikeAvg > 25 and fwd < bikeAvg * 0.4 then
				bikeDrop = bikeDrop + 1
			else
				bikeDrop = 0
			end
			if bikeDrop >= 3 or v.Y > 45 then
				bikeCut = tick() + 0.5
				bikeTarget = math.max(0, fwd)
				bikeAvg, bikeDrop = 0, 0
				lv.MaxForce = 0
				lv.LineVelocity = 0
				bikeSay("Tabrakan: boost mati sebentar")
				return
			end
			bikeAvg = bikeAvg * 0.9 + fwd * 0.1

			if bikeMode == "instant" then
				bikeTarget = need
			elseif bikeTarget < need then
				bikeTarget = math.min(need, bikeTarget + need * 0.03 + 0.8) -- naik pelan ke need
			else
				bikeTarget = need
			end

			-- dorong hanya searah jalan (sumbu atas/bawah dibiarkan natural)
			lv.MaxForce = bikeMode == "instant" and 35000 or 18000
			lv.LineDirection = flat
			lv.LineVelocity = bikeTarget
		else
			-- lepas gas / terbalik / habis tabrakan: matikan boost, biar motor ngerem natural
			lv.MaxForce = 0
			lv.LineVelocity = 0
			if tick() < bikeCut then
				bikeTarget = math.max(0, fwd) -- lanjut dari speed sekarang, bukan dari nol
			else
				bikeTarget = math.max(0, bikeTarget * 0.92)
			end
			bikeAvg, bikeDrop = 0, 0
			if not upright then bikeCut = math.max(bikeCut, tick() + 0.6) end
		end

		local hud = ctx.velocity and tonumber(ctx.velocity.Value) or 0
		bikeSay(string.format("[%s] %d | HUD %.0f | gas=%s", bikeMode == "smooth" and "LERENG" or "LANGSUNG", kmh, hud, throttle > 0 and "ON" or "off"))
	end

	local function bikeStop()
		bikeOn = false
		if bikeConn then bikeConn:Disconnect() bikeConn = nil end
		bikeClear()
		bikeTarget, bikeCut, bikeAvg, bikeDrop = 0, 0, 0, 0
		if bikeSt then bikeSt.Text = "Speed OFF" end
	end

	local function toggleBike()
		if bikeOn then
			bikeStop()
		else
			bikeOn = true
			bikeConn = RunService.Heartbeat:Connect(function()
				bikeApply(bikeKmh)
			end)
		end
		paint()
	end

	local function stopAll()
		kurirOn, baksoOn = false, false
		bikeStop()
		paint()
		st.Text = "Semua OFF"
	end

