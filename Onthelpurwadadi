	-- BANTU: kunjungi prompt (dipakai claim meme)
	------------------------------------------------------------
	-- kunjungi prompt cepat: TP sekali, fire 2-3x, jeda pendek
	local function visitPrompts(container, dTP, dAfter)
		dTP, dAfter = dTP or 0.12, dAfter or 0.05
		if not container then return 0 end
		local list = {}
		if container:IsA("ProximityPrompt") then list[1] = container end
		for _, d in ipairs(container:GetDescendants()) do
			if d:IsA("ProximityPrompt") then list[#list + 1] = d end
		end
		local base = posOf(container)
		if base then
			tp(base, true)
			task.wait(dTP)
		end
		local n = 0
		for _, p in ipairs(list) do
			local pp = posOf(p.Parent)
			if pp and base and (pp - base).Magnitude > 20 then
				tp(pp, true)
				task.wait(dTP)
				base = pp
			end
			-- fire 2x biar stabil tanpa delay panjang
			if firePrompt(p) then n = n + 1 end
			task.wait(0.03)
			firePrompt(p)
			task.wait(dAfter)
		end
		return n
	end

	------------------------------------------------------------
	-- AUTO CLAIM ALL MEME: satu tombol. TP ke posisi asset meme (bukan kordinat fixed), pencet prompt, jeda MEME_GAP detik antar meme,
	-- lalu balik ke posisi semula.
	------------------------------------------------------------
	local MEME_GAP = 0.35 -- jeda antar meme (dtk) — lebih cepat
	local MEME_ARRIVE = 0.12 -- tunggu sesudah TP
	local MEME_AFTER = 0.05 -- jeda sesudah prompt
		-- asset path saja (TANPA koordinat — biar ga ngebug)
	local memeDefs = {
		{ name = "meme upin", get = function() return workspace:FindFirstChild("meme upin") end },
		{ name = "meme 1", get = function()
			local f = workspace:FindFirstChild("meme")
			return f and f:FindFirstChild("meme 1")
		end },
		{ name = "meme 2", get = function()
			local f = workspace:FindFirstChild("meme")
			return f and f:FindFirstChild("meme 2")
		end },
		{ name = "meme 3", get = function()
			local f = workspace:FindFirstChild("meme")
			return f and f:FindFirstChild("meme 3")
		end },
		{ name = "meme baru 8", get = function() return workspace:FindFirstChild("meme baru 8") end },
	}


	local function hasPrompt(o)
		return o:IsA("ProximityPrompt") or o:FindFirstChildWhichIsA("ProximityPrompt", true) ~= nil
	end

	-- hasil: true/false — TP dari posisi ASSET saja (tanpa Vector3 fixed)
	local function claimDef(def)
		local obj = def.get()
		if not obj then
			return false, "asset tidak ada di workspace"
		end
		local p = posOf(obj)
		if not p then
			return false, "tidak ada BasePart di meme"
		end
		tp(p, true)
		task.wait(MEME_ARRIVE)
		-- refresh object setelah stream
		obj = def.get() or obj
		if not hasPrompt(obj) then
			task.wait(0.15)
			obj = def.get() or obj
			if not hasPrompt(obj) then
				return false, "prompt tidak ketemu"
			end
		end
		local n = visitPrompts(obj, MEME_ARRIVE, MEME_AFTER)
		if n == 0 then
			task.wait(0.08)
			n = visitPrompts(obj, 0.1, 0.04)
		end
		if n == 0 then return false, "prompt gagal dipencet" end
		return true
	end

	local claiming = false
	local function claimAllMeme()
		if claiming then return end
		claiming = true
		pauseJobs = true
		if kurirOn or baksoOn then task.wait(0.3) end -- biar langkah job yang sedang jalan selesai dulu
		local root = getRoot()
		local back = root and root.CFrame
		local done, fails = 0, {}
		for i, def in ipairs(memeDefs) do
			local pre = def.get()
			if not pre or not posOf(pre) then
				st.Text = "Skip " .. def.name .. " (belum kerender)"
				fails[#fails + 1] = def.name .. " (belum kerender)"
			else
				st.Text = "Meme: klaim " .. def.name .. " (" .. i .. "/" .. #memeDefs .. ")..."
				local okc, ok, why = pcall(claimDef, def)
				if okc and ok then
					done = done + 1
				else
					fails[#fails + 1] = def.name .. " (" .. tostring(okc and why or ok) .. ")"
				end
			end
			if i < #memeDefs then task.wait(MEME_GAP) end
		end
		root = getRoot()
		if root and back then root.CFrame = back end
		pauseJobs = false
		claiming = false
		local txt = "Meme: " .. done .. "/" .. #memeDefs .. " diklaim"
		if typeof(fireproximityprompt) ~= "function" then
			txt = txt .. " | executor tidak punya fireproximityprompt"
		end
		if #fails > 0 then
			txt = txt .. " | gagal: " .. table.concat(fails, ", ")
			warn("[KerjaHub] " .. table.concat(fails, " ; "))
		end
		st.Text = txt
	end

