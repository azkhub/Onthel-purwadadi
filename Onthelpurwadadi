	new("UIPadding", {
		PaddingTop = UDim.new(0, 8), PaddingBottom = UDim.new(0, 8), PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 10),
	}, setPage)

	local Lighting = game:GetService("Lighting")
	local gfx = { low = false, mat = false, ql = false, far = false }
	local orig = setmetatable({}, { __mode = "k" }) -- instance -> { properti = nilai asli }
	local qlOrig = nil

	local function put(o, prop, v)
		local t = orig[o]
		if not t then
			t = {}
			orig[o] = t
		end
		if t[prop] == nil then
			local ok, cur = pcall(function() return o[prop] end)
			if ok then t[prop] = cur end
		end
		pcall(function() o[prop] = v end)
	end

	local function restoreProps(filter)
		for o, t in pairs(orig) do
			for prop, v in pairs(t) do
				if not filter or filter(prop) then
					pcall(function() o[prop] = v end)
					t[prop] = nil
				end
			end
		end
	end

	local function isFogProp(p) return p == "FogEnd" or p == "FogStart" or p == "Density" or p == "Haze" end

	-- visual saja (tidak mengubah fisika)
	local function lowInst(o)
		if o:IsA("BasePart") then
			if o:IsA("Terrain") then return end
			put(o, "CastShadow", false)
			put(o, "Reflectance", 0)
			if o:IsA("MeshPart") then put(o, "RenderFidelity", Enum.RenderFidelity.Performance) end
		elseif o:IsA("Decal") or o:IsA("Texture") then
			put(o, "Transparency", 1)
		elseif o:IsA("ParticleEmitter") or o:IsA("Trail") or o:IsA("Beam") or o:IsA("Fire") or o:IsA("Smoke") or o:IsA("Sparkles") then
			put(o, "Enabled", false)
		elseif o:IsA("PostEffect") then
			put(o, "Enabled", false)
		end
	end
	local function matInst(o)
		if o:IsA("BasePart") and not o:IsA("Terrain") then
			put(o, "Material", Enum.Material.SmoothPlastic)
		end
	end
	local function lowGlobal()
		put(Lighting, "GlobalShadows", false)
		put(Lighting, "ShadowSoftness", 0)
		put(Lighting, "EnvironmentSpecularScale", 0)
		local T = workspace:FindFirstChildOfClass("Terrain")
		if T then
			put(T, "WaterWaveSize", 0)
			put(T, "WaterWaveSpeed", 0)
			put(T, "WaterReflectance", 0)
			put(T, "Decoration", false)
		end
	end
	local function sweep(root, fn)
		local n = 0
		for _, o in ipairs(root:GetDescendants()) do
			pcall(fn, o)
			n = n + 1
			if n % 250 == 0 then task.wait() end
		end
	end
	local function setQL(on)
		local ok, rs = pcall(function() return settings().Rendering end)
		if not ok or not rs then return false end
		return pcall(function()
			if on then
				if qlOrig == nil then qlOrig = rs.QualityLevel end
				rs.QualityLevel = Enum.QualityLevel.Level01
			elseif qlOrig ~= nil then
				rs.QualityLevel = qlOrig
				qlOrig = nil
			end
		end)
	end
	local function farApply()
		put(Lighting, "FogEnd", 1e8)
		put(Lighting, "FogStart", 1e8)
		for _, o in ipairs(Lighting:GetDescendants()) do
			if o:IsA("Atmosphere") then
				put(o, "Density", 0)
				put(o, "Haze", 0)
			end
		end
	end

	-- objek baru yang muncul ikut diubah
	local function onAdded(o)
		if gfx.low then pcall(lowInst, o) end
		if gfx.mat then pcall(matInst, o) end
	end
	workspace.DescendantAdded:Connect(function(o)
		if gfx.low or gfx.mat then task.defer(onAdded, o) end
	end)
	Lighting.DescendantAdded:Connect(function(o)
		if gfx.low then task.defer(onAdded, o) end
	end)

	section("GRAFIK")
	local gst = mkNote("Grafik: normal", C(160, 200, 160), 16)
	local fpsLabel = mkNote("FPS: ...", C(140, 225, 255), 16)
	do
		local frames = 0
		RunService.RenderStepped:Connect(function() frames = frames + 1 end)
		task.spawn(function()
			while true do
				task.wait(1)
				fpsLabel.Text = "FPS: " .. frames
				frames = 0
			end
		end)
	end

	local busyG = false
	local function toggleLow()
		if busyG then return end
		busyG = true
		gfx.low = not gfx.low
		paint()
		task.spawn(function()
			if gfx.low then
				gst.Text = "Grafik: menerapkan..."
				lowGlobal()
				sweep(workspace, lowInst)
				sweep(Lighting, lowInst)
				gst.Text = "Grafik: SUPER RENDAH aktif"
			else
				restoreProps(function(p) return p ~= "Material" and not isFogProp(p) end)
				gst.Text = "Grafik: dikembalikan"
			end
			busyG = false
		end)
	end
	local function toggleMat()
		if busyG then return end
		busyG = true
		gfx.mat = not gfx.mat
		paint()
		task.spawn(function()
			if gfx.mat then
				gst.Text = "Material: menerapkan..."
				sweep(workspace, matInst)
				gst.Text = "Material polos aktif"
			else
				restoreProps(function(p) return p == "Material" end)
				gst.Text = "Material dikembalikan"
			end
			busyG = false
		end)
	end
	local function toggleQL()
		gfx.ql = not gfx.ql
		local ok = setQL(gfx.ql)
		if not ok then
			gfx.ql = false
			gst.Text = "Executor tidak bisa ubah Quality Level"
		else
			gst.Text = gfx.ql and "Quality Level 1 aktif" or "Quality Level dikembalikan"
		end
		paint()
	end
	local function toggleFar()
		gfx.far = not gfx.far
		if gfx.far then
			farApply()
			gst.Text = "Render jauh: kabut dihilangkan"
		else
			restoreProps(isFogProp)
			gst.Text = "Kabut dikembalikan"
		end
		paint()
	end

	mkSwitch("GRAFIK SUPER RENDAH", function() return gfx.low end, toggleLow)
	mkSwitch("RENDER JAUH (tanpa kabut)", function() return gfx.far end, toggleFar)
	mkSwitch("MATERIAL POLOS", function() return gfx.mat end, toggleMat)
	mkSwitch("QUALITY LEVEL 1", function() return gfx.ql end, toggleQL)
	mkWide("RESET SEMUA GRAFIK", C(170, 60, 60), function()
		gfx.low, gfx.mat, gfx.far, gfx.ql = false, false, false, false
		restoreProps()
		setQL(false)
		paint()
		gst.Text = "Grafik: semua dikembalikan"
	end)
	mkNote("SUPER RENDAH: bayangan, efek, partikel, tekstur/decal, air, pantulan dimatikan. Fisika tidak berubah.", C(180, 190, 210), 44)
	mkNote("MATERIAL POLOS: semua part jadi SmoothPlastic, bisa mengubah gesekan (motor/jalan). Matikan kalau terasa aneh.", C(255, 170, 80), 44)
	mkNote("QUALITY LEVEL 1: paling ringan, tapi di beberapa game bisa mengurangi jarak render. Kalau objek jauh hilang, matikan.", C(255, 170, 80), 44)
	mkNote("Objek jauh hanya muncul kalau game sudah memuatnya (StreamingEnabled). Script tidak bisa memaksa game memuat lebih jauh.", C(180, 190, 210), 44)
	pageTarget = farmPage

