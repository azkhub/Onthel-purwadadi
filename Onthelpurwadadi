	-- DEALER: sekali klik = TP ke dealer + pencet DealerPrompt-nya.
	-- Kalau dealer belum kerender, TP ke posisi yang pernah diingat (dekati sekali dulu).
	------------------------------------------------------------
	local dealerDefs = {
		{ name = "Dealer Polygon", get = function() local d = workspace:FindFirstChild("Dealers"); return d and d:FindFirstChild("PolygonDealer") end },
		{ name = "Dealer Custom", get = function() local d = workspace:FindFirstChild("Dealers"); return d and d:FindFirstChild("CustomDealer") end },
	}
	local dealerPos = {}
	local dealerBusy = false
	local function goDealer(def)
		if dealerBusy then return end
		dealerBusy = true
		local obj = def.get()
		local pos = obj and posOf(obj)
		if pos then
			dealerPos[def.name] = pos
		else
			pos = dealerPos[def.name]
		end
		if not pos then
			st.Text = def.name .. ": belum kerender, dekati sekali dulu supaya posisinya diingat"
			dealerBusy = false
			return
		end
		if not obj or not posOf(obj) then
			tp(pos, true) -- TP + minta server stream area dealer
			local t = 0
			while t < 4 do
				obj = def.get()
				if obj and posOf(obj) then break end
				task.wait(0.1)
				t = t + 0.1
			end
		end
		if not obj then
			st.Text = def.name .. ": tidak muncul walau sudah di-TP"
			dealerBusy = false
			return
		end
		-- tunggu DealerPrompt ter-load (UpperTorso.DealerPrompt)
		local t = 0
		while t < 3 and not obj:FindFirstChild("DealerPrompt", true) do
			task.wait(0.1)
			t = t + 0.1
		end
		st.Text = def.name .. ": TP + pencet prompt..."
		local n = visitPrompts(obj, 0.3, 0.1) -- tetap di dealer, tidak balik (GUI dealer bisa tertutup kalau jauh)
		st.Text = (n > 0) and (def.name .. ": prompt dipencet") or (def.name .. ": prompt tidak ketemu")
		dealerBusy = false
	end

