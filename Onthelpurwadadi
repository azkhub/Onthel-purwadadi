	-- baca rumah tujuan dari TutorialBeam label
	-- nil = belum ada rumah (masih tahap kantor / ambil paket)
	local function getBeamHouseName()
		local beam = workspace:FindFirstChild("TutorialBeam")
		local light = beam and beam:FindFirstChild("LightBeam")
		local label = light and light:FindFirstChild("BeamLabel")
		local frame = label and label:FindFirstChild("Frame")
		local tl = frame and frame:FindFirstChild("TextLabel")
		if not tl and beam then
			for _, d in ipairs(beam:GetDescendants()) do
				if d:IsA("TextLabel") then
					local tx = string.lower(tostring(d.Text or ""))
					if tx ~= "" then tl = d break end
				end
			end
		end
		if not tl then return nil end
		local t = tostring(tl.Text or ""):gsub("^%s+", ""):gsub("%s+$", "")
		if t == "" then return nil end
		local low = string.lower(t)
		-- teks kantor / ambil paket → bukan rumah
		if string.find(low, "kantor", 1, true)
			or string.find(low, "kurir", 1, true)
			or string.find(low, "paket", 1, true)
			or string.find(low, "ambil", 1, true)
			or string.find(low, "office", 1, true) then
			return nil
		end
		for _, name in ipairs(houses) do
			if t == name or string.find(low, string.lower(name), 1, true) then
				return name
			end
		end
		local job = workspace:FindFirstChild("JobLocations")
		local points = job and job:FindFirstChild("DeliveryPoints")
		if points then
			local direct = points:FindFirstChild(t)
			if direct then return t end
			for _, ch in ipairs(points:GetChildren()) do
				if string.find(low, string.lower(ch.Name), 1, true)
					or string.find(string.lower(ch.Name), low, 1, true) then
					return ch.Name
				end
			end
		end
		return nil -- teks tidak dikenali = ke kantor
	end

