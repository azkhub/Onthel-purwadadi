	local function toBottom()
		task.defer(function() msgs.CanvasPosition = Vector2.new(0, 1e6) end)
	end

	local function fetchNew()
		if fetching or not currentUsername then return end
		fetching = true
		local initial = (lastId == 0)
		local path
		if lastId == 0 then
			path = "/rest/v1/pesan?select=id,username,content,source&order=id.desc&limit=50"
		else
			path = "/rest/v1/pesan?select=id,username,content,source&id=gt." .. lastId .. "&order=id.asc&limit=100"
		end
		local data, code = httpRequest("GET", path)
		if isOk(code) and type(data) == "table" then
			if lastId == 0 then
				local r = {}
				for i = #data, 1, -1 do table.insert(r, data[i]) end
				data = r
			end
			for _, m in ipairs(data) do
				if m.id and m.id > lastId then
					addMessage(m, not initial)
					lastId = m.id
				end
			end
			if #data > 0 then toBottom() end
			chatSt.TextColor3 = C(120, 255, 150)
			chatSt.Text = "Masuk sebagai: @" .. tostring(currentUsername)
		else
			chatSt.TextColor3 = C(255, 120, 120)
			chatSt.Text = "Gagal ambil pesan (kode " .. tostring(code) .. ")"
		end
		fetching = false
	end

	local function sendMessage(text)
		if not currentUsername or not accessToken then return end
		if text:match("^%s*$") then return end
		text = text:sub(1, 300)
		local function post()
			return httpRequest("POST", "/rest/v1/pesan", { content = text, source = "game" }, accessToken, { ["Prefer"] = "return=minimal" })
		end
		local data, code = post()
		if code == 401 and refreshSession() then data, code = post() end
		if isOk(code) then
			inputBox.Text = ""
			fetchNew()
		else
			chatSt.TextColor3 = C(255, 120, 120)
			local msg = type(data) == "table" and data.message or nil
			chatSt.Text = msg and tostring(msg) or ("Gagal kirim (kode " .. tostring(code) .. ")")
		end
	end
	sendBtn.Activated:Connect(function() sendMessage(inputBox.Text) end)
	inputBox.FocusLost:Connect(function(enter)
		if enter then sendMessage(inputBox.Text) end
	end)

	local polling = false
	local function startChat()
		loginPanel.Visible = false
		chatPanel.Visible = true
		if polling then return end
		polling = true
		task.spawn(function()
			while gui.Parent do
				if chatPage.Visible and window.Visible then fetchNew() end
				task.wait(2.5)
			end
		end)
	end

	logoutBtn.Activated:Connect(function()
		clearSession()
		currentUsername, accessToken, refreshToken = nil, nil, nil
		lastId, count = 0, 0
		for _, c in ipairs(msgs:GetChildren()) do
			if c:IsA("Frame") then c:Destroy() end
		end
		passBox.Text = ""
		chatPanel.Visible = false
		loginPanel.Visible = true
		loginSt.TextColor3 = C(180, 200, 255)
		loginSt.Text = "Kamu sudah keluar."
	end)

	local busy = false
	local function doAuth(mode)
		if busy then return end
		local name = userBox.Text:lower():gsub("%s", "")
		local pass = passBox.Text
		if not name:match("^[a-z0-9_]+$") or #name < 3 or #name > 20 then
			loginSt.TextColor3 = C(255, 100, 100)
			loginSt.Text = "Username hanya huruf kecil, angka, _ (3-20 karakter)"
			return
		end
		if #pass < 6 then
			loginSt.TextColor3 = C(255, 100, 100)
			loginSt.Text = "Password minimal 6 karakter"
			return
		end
		busy = true
		loginSt.TextColor3 = C(255, 200, 50)
		loginSt.Text = mode == "reg" and "Membuat akun..." or "Masuk..."
		local ok, err = authenticate(mode, name, pass)
		busy = false
		if ok then
			passBox.Text = ""
			loginSt.TextColor3 = C(120, 255, 150)
			loginSt.Text = "Berhasil!"
			startChat()
		else
			loginSt.TextColor3 = C(255, 90, 90)
			loginSt.Text = tostring(err)
		end
	end
	regBtn.Activated:Connect(function() doAuth("reg") end)
	logBtn.Activated:Connect(function() doAuth("log") end)
	passBox.FocusLost:Connect(function(enter) if enter then doAuth("log") end end)

	-- auto login kalau sesi sudah tersimpan
	local savedName, savedRefresh = loadSession()
	if savedName then
		refreshToken = savedRefresh
		task.defer(function()
			if refreshSession() then
				currentUsername = savedName
				startChat()
			else
				refreshToken = nil
				loginSt.TextColor3 = C(255, 200, 50)
				loginSt.Text = "Sesi habis, silakan masuk lagi."
			end
		end)
	end
end

