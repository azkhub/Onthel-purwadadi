		if animate then
			local sc = new("UIScale", { Scale = 0.4 }, wrap)
			TS:Create(sc, TweenInfo.new(0.28, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
