				Instance.new("UICorner", bg).CornerRadius = UDim.new(0, 6)
				local t1 = Instance.new("TextLabel")
				t1.BackgroundTransparency = 1
				t1.Size = UDim2.new(1, -6, 0, 20)
				t1.Position = UDim2.fromOffset(3, 2)
				t1.Font = FONT
				t1.TextSize = 12
				t1.TextColor3 = Color3.new(1, 1, 1)
				t1.Text = def.name
				t1.TextXAlignment = Enum.TextXAlignment.Left
				t1.Parent = bg
				new("UIStroke", { Thickness = 1.2, Color = Color3.new(0, 0, 0) }, t1)
				local t2 = Instance.new("TextLabel")
				t2.BackgroundTransparency = 1
				t2.Size = UDim2.new(1, -6, 0, 18)
				t2.Position = UDim2.fromOffset(3, 22)
				t2.Font = FONT
				t2.TextSize = 11
				t2.TextColor3 = rendered and C(120, 255, 140) or C(255, 120, 120)
				t2.Text = rendered and "KERENDER" or "BELUM KERENDER"
				t2.TextXAlignment = Enum.TextXAlignment.Left
				t2.Parent = bg
				new("UIStroke", { Thickness = 1.2, Color = Color3.new(0, 0, 0) }, t2)
				-- highlight
				pcall(function()
					local h = Instance.new("Highlight")
					h.FillColor = rendered and C(60, 200, 90) or C(200, 60, 60)
					h.OutlineColor = Color3.new(1, 1, 1)
					h.FillTransparency = 0.7
					h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
					h.Adornee = obj:IsA("Model") and obj or part
					h.Parent = memeEspFolder
				end)
			end
		end
		-- status ringkas di st
		local okn, badn = 0, 0
		for _, def in ipairs(memeDefs) do
			local o = def.get()
			if o and posOf(o) then okn = okn + 1 else badn = badn + 1 end
		end
		st.Text = string.format("ESP Meme: %d kerender, %d belum", okn, badn)
	end
	local function toggleMemeEsp()
		memeEspOn = not memeEspOn
		if memeEspOn then
			refreshMemeEsp()
		else
			clearMemeEsp()
			st.Text = "ESP Meme OFF"
		end
		paint()
	end
	mkSwitch("ESP MEME", function() return memeEspOn end, toggleMemeEsp)
	mkWide("REFRESH ESP MEME", C(70, 130, 200), function()
		if memeEspOn then refreshMemeEsp() else st.Text = "Nyalakan ESP MEME dulu" end
	end)
	mkWide("AUTO CLAIM ALL MEME", C(190, 120, 40), function() task.spawn(claimAllMeme) end)
	-- loop refresh ESP tiap 2 dtk
	task.spawn(function()
		while true do
			task.wait(2)
			if memeEspOn then
				pcall(refreshMemeEsp)
			end
		end
	end)
	section("ANTI PAUSE")
	mkSwitch("ANTI GAMEPLAY PAUSED", function() return antiPause end, toggleAnti)
	section("PENGATURAN")
	mkStepper("DELAY TP (dtk)", function() return delayTP end, function(v) delayTP = v end, 0.05, 5, 0.05)
	mkStepper("DELAY AKSI (dtk)", function() return delayAfter end, function(v) delayAfter = v end, 0.05, 5, 0.05)
	section("GUI GAME")
	mkPair("BUKA JOB GUI", C(70, 110, 200), function() openGui("JobGui") end, "TUTUP JOB GUI", C(190, 80, 90), function() closeGui("JobGui") end)

	-- CODES: redeem semua code lewat ReplicatedStorage.CodesSystem.RedeemCode
	local CODES = {
		"ACEWHEELIE",
		"HIREZ",
		"ACEBAUKETEK",
	}
	local redeeming = false
	mkFolder("CODES", false)
	mkWide("REDEEM ALL CODES", C(60, 150, 90), function()
		if redeeming then return end
		redeeming = true
		task.spawn(function()
			local rs = game:GetService("ReplicatedStorage")
			local sys = rs:WaitForChild("CodesSystem", 5)
			local ev = sys and sys:WaitForChild("RedeemCode", 5)
			if not ev then
				st.Text = "Codes: remote RedeemCode tidak ketemu"
				redeeming = false
				return
			end
			for i, code in ipairs(CODES) do
				st.Text = "Codes " .. i .. "/" .. #CODES .. ": " .. code
				pcall(function() ev:FireServer(code) end)
				task.wait(0.7)
			end
			st.Text = "Codes: " .. #CODES .. " code dikirim"
			redeeming = false
		end)
	end)

	-- RACE (paling bawah, di bawah semua folder lain)
	mkFolder("RACE", false)
	mkSwitch("BIKE SPEED", function() return bikeOn end, toggleBike)
	mkStepper("SPEED (km/jam)", function() return bikeKmh end, function(v) bikeKmh = v end, 10, BIKE_MAX, 5, "%.0f")
	local bikeModeBtn
	bikeModeBtn = mkWide("MODE: LERENG (naik pelan)", C(70, 130, 200), function()
		if bikeMode == "smooth" then
			bikeMode = "instant"
			bikeModeBtn.Text = "MODE: LANGSUNG (full)"
			bikeModeBtn.BackgroundColor3 = C(200, 100, 50)
		else
			bikeMode = "smooth"
			bikeModeBtn.Text = "MODE: LERENG (naik pelan)"
			bikeModeBtn.BackgroundColor3 = C(70, 130, 200)
		end
	end)
	bikeSt = mkNote("Speed OFF", C(160, 200, 160), 16)
	mkNote("NOTE: jangan pakai speed 200+ biar tidak kena banned (batas maksimal di sini 199).", C(255, 170, 80), 32)
	mkNote("LinearVelocity = lebih mulus. Boost saat gas. Lepas gas = stop boost.", C(180, 190, 210), 32)

	currentFolder = nil
	mkWide("STOP SEMUA", C(170, 60, 60), stopAll)

	RunService.Heartbeat:Connect(function()
		if not baksoOn then return end
		if tick() - lastServe < 0.3 then return end
		lastServe = tick()
		serveAll()
	end)

	paint()
	print("[Kerja Hub] Onthel Purwadadi OK")
end

task.spawn(startKerjaHub)

-- buka window dengan animasi saat script jalan
task.defer(function()
	task.wait(0.3)
	setOpen(true)
end)
